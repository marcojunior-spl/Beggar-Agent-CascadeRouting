# Copie este arquivo para ".env" (na mesma pasta) e preencha com as chaves que
# você já tem. NUNCA coloque chaves de API diretamente no código-fonte ou
# faça commit do .env real.
#
# IMPORTANTE: você NÃO precisa preencher todas as chaves abaixo. A aplicação
# descobre automaticamente quais provedores estão configurados (via a
# variável de ambiente de cada um) e só usa esses. Configure quantos quiser
# — quanto mais provedores gratuitos configurados, mais resiliente fica o
# fallback em cascata.

# ============================================================
# PROVEDORES EM NUVEM (todos com tier gratuito)
# ============================================================

# Google AI Studio — Gemini Flash/Pro (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Groq Cloud — Llama, DeepSeek R1 Distill, Gemma, GPT-OSS (https://console.groq.com/keys)
GROQ_API_KEY=

# OpenRouter — agregador com modelos gratuitos (":free") de vários provedores
# (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# GitHub Models — GPT-4o-mini, Phi-4, DeepSeek, Llama (https://github.com/settings/tokens)
# Use um Personal Access Token do GitHub (não precisa de permissões especiais).
GITHUB_API_KEY=

# Cloudflare Workers AI — requer DUAS variáveis: a chave e o ID da conta
# (https://developers.cloudflare.com/workers-ai/)
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# Mistral AI — Mistral Small, Codestral (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=

# Cerebras Cloud — inferência ultrarrápida (https://cloud.cerebras.ai)
CEREBRAS_API_KEY=

# Cohere — Command R/R+ (https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=

# SambaNova Cloud — Llama 70B/405B (https://cloud.sambanova.ai/apis)
SAMBANOVA_API_KEY=

# Hugging Face — acesso a modelos de nicho via provedores de inferência
# (https://huggingface.co/settings/tokens)
HF_TOKEN=

# ============================================================
# MODELO LOCAL VIA OLLAMA (fallback extremo)
# ============================================================
# O modelo local só é usado como ÚLTIMO recurso, depois que todos os
# provedores em nuvem configurados acima falharem ou estiverem com cota
# esgotada (rate-limit).
#
# Defina como "false" para desativar completamente essa opção.
OLLAMA_ENABLED=true

# Nome do modelo, exatamente como aparece em `ollama list`.
OLLAMA_MODEL=qwen2.5-coder:7b

# Endereço do servidor Ollama (o padrão já funciona para instalação local comum).
OLLAMA_API_BASE=http://localhost:11434

# Tempo máximo (segundos) que uma chamada ao modelo local pode levar antes de
# ser abortada — protege a aplicação de travar caso o Ollama fique lento.
OLLAMA_TIMEOUT_SEGUNDOS=45

# ============================================================
# TIMEOUTS E ORÇAMENTO GLOBAL
# ============================================================

# Tempo máximo (segundos) que UMA chamada a um provedor em nuvem pode levar
# antes de ser abandonada e o próximo da cadeia ser tentado. Aplicado em
# TODAS as execuções (via thread separada com timeout).
#
# POR QUE ISSO EXISTE: o smolagents dispara vários steps por chamada, e o
# retry interno do litellm pode obedecer `RetryInfo.retryDelay` do provedor
# (o Google manda "retry in 9s" e o cliente espera de verdade). Já vimos um
# único `agente.run()` durar 843 segundos — muito além de qualquer timeout
# de HTTP por request. Este valor garante que uma tentativa ruim não
# consuma o orçamento global inteiro.
TIMEOUT_POR_PROVEDOR_SEGUNDOS=45

# Tempo máximo (segundos) que UMA requisição inteira pode gastar tentando
# todos os provedores, incluindo retries e backoffs em cascata. Quando
# estoura, a cadeia para de tentar e devolve erro fatal.
TEMPO_MAXIMO_TOTAL_SEGUNDOS=90

# ============================================================
# CONFIGURAÇÕES GERAIS DA APLICAÇÃO
# ============================================================

# Origens do frontend que podem acessar esta API (separadas por vírgula, sem
# espaço). Proteção CORS: o navegador bloqueia silenciosamente qualquer
# chamada vinda de uma origem que não esteja nesta lista.
#
# Ao expor via túnel (Cloudflare/ngrok), adicione a URL pública do túnel do
# FRONTEND aqui (não a do backend).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Limite de mensagens por minuto por IP (proteção simples contra abuso caso
# o serviço esteja exposto publicamente via túnel).
RATE_MAX_MSGS_POR_MINUTO=10

# Caminho do arquivo de log de falhas do agente.
AGENTE_LOG_FILE=agente_falhas.log

# Caminho da pasta onde o ChromaDB salva a memória vetorial do agente.
AGENTE_CHROMA_PATH=./chroma_db

# Caminho do arquivo SQLite que persiste as conversas (histórico por sessão).
AGENTE_DB_PATH=./conversas.db